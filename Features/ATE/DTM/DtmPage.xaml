<base:PageBase x:Class="ATE.DtmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ATE"
             xmlns:dtm="clr-namespace:ATE.DTM"
             xmlns:base="clr-namespace:Base.Pages;assembly=Base"
			 xmlns:mtc="clr-namespace:Base.Components;assembly=Base"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<Grid>
		<ui:SimpleStackPanel x:Name="DtmEntryContainer" Orientation="Vertical" Spacing="6">
			<dtm:DTMDeviceEntry x:Name="DtmEntry1"/>
			<dtm:DTMDeviceEntry x:Name="DtmEntry2"/>
			<dtm:DTMDeviceEntry x:Name="DtmEntry3"/>
			<dtm:DTMDeviceEntry x:Name="DtmEntry4"/>
			<Button x:Name="NewEntryButton" Content="New" FontSize="18" Margin="8,0" HorizontalAlignment="Stretch"/>
		</ui:SimpleStackPanel>
    </Grid>
</base:PageBase>
