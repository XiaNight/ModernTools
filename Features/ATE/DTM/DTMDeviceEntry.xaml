<UserControl x:Class="ATE.DTM.DTMDeviceEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ATE.DTM"
			 xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="800">
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="240"/>
			<ColumnDefinition Width="160"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>
		<ComboBox x:Name="DeviceDropdown" Grid.Column="0" Grid.Row="0" Margin="4"
				  VerticalAlignment="Center" HorizontalAlignment="Stretch"
				  DropDownOpened="DeviceDropdown_DropDownOpened"
				  SelectionChanged ="DeviceDropdown_SelectionChanged"/>
		<ComboBox x:Name="PayloadModel" Grid.Column="1" Grid.Row="0" Margin="4" VerticalAlignment="Center" HorizontalAlignment="Stretch" SelectedIndex="3" IsEnabled="False">
			<ComboBoxItem Content="PRBS9"/>
			<ComboBoxItem Content="11110000"/>
			<ComboBoxItem Content="10101010"/>
			<ComboBoxItem Content="Constant_Carrier"/>
		</ComboBox>
		<TextBlock x:Name="FrequencyText" Grid.Column="3" Grid.Row="0" Margin="4" VerticalAlignment="Center" FontSize="18" Text="2400MHz"/>
		<Button x:Name="StartButton" Grid.Column="4" Grid.Row="0" Margin="4"
				Content="Start" Width="100" Height="30" VerticalAlignment="Center"
				Click="StartButton_Click"/>
		<Button x:Name="StopButton" Grid.Column="5" Grid.Row="0" Margin="4"
				Content="Stop" Width="100" Height="30" VerticalAlignment="Center" Visibility="Collapsed"
				Click="StopButton_Click"/>

		<Grid Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<TextBox x:Name="UsageInputbox" Grid.Column="0" Margin="4"  ui:TextBoxHelper.IsDeleteButtonVisible="False"/>
			<TextBox x:Name="UsagepageInputbox" Grid.Column="1" Margin="4" ui:TextBoxHelper.IsDeleteButtonVisible="False"/>
		</Grid>
	</Grid>
</UserControl>
