<base:PageBase x:Class="Camera.CameraPage"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:local="clr-namespace:Camera"
               xmlns:base="clr-namespace:Base.Pages;assembly=Base"
               xmlns:ui="http://schemas.modernwpf.com/2019"
               mc:Ignorable="d"
               d:DesignHeight="600"
               d:DesignWidth="900">

	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Toolbar -->
		<StackPanel Grid.Row="0"
		            Orientation="Horizontal">

			<TextBlock Text="Camera:"
			           VerticalAlignment="Center"
			           Margin="0,0,8,0"
			           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>

			<ComboBox x:Name="CameraCombo"
			          MinWidth="320"
			          VerticalAlignment="Center"
			          SelectionChanged="CameraCombo_SelectionChanged"/>

		</StackPanel>

		<!-- Camera Controls -->
		<Grid Grid.Row="1"
		      Margin="0,12,0,0">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="70"/>
				<ColumnDefinition Width="24"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="70"/>
			</Grid.ColumnDefinitions>

			<!-- Exposure -->
			<TextBlock Grid.Row="0"
			           Grid.Column="0"
			           Text="Exposure:"
			           VerticalAlignment="Center"
			           Margin="0,0,8,0"/>

			<Slider x:Name="ExposureSlider"
			        Grid.Row="0"
			        Grid.Column="1"
			        MinWidth="180"
			        IsEnabled="False"
			        VerticalAlignment="Center"
			        ValueChanged="ExposureSlider_ValueChanged"/>

			<TextBlock x:Name="ExposureValueText"
			           Grid.Row="0"
			           Grid.Column="2"
			           Text="-"
			           VerticalAlignment="Center"
			           HorizontalAlignment="Right"/>

			<!-- Brightness -->
			<TextBlock Grid.Row="0"
			           Grid.Column="4"
			           Text="Brightness:"
			           VerticalAlignment="Center"
			           Margin="0,0,8,0"/>

			<Slider x:Name="BrightnessSlider"
			        Grid.Row="0"
			        Grid.Column="5"
			        MinWidth="180"
			        IsEnabled="False"
			        VerticalAlignment="Center"
			        ValueChanged="BrightnessSlider_ValueChanged"/>

			<TextBlock x:Name="BrightnessValueText"
			           Grid.Row="0"
			           Grid.Column="6"
			           Text="-"
			           VerticalAlignment="Center"
			           HorizontalAlignment="Right"/>

			<!-- Contrast -->
			<TextBlock Grid.Row="1"
			           Grid.Column="0"
			           Text="Contrast:"
			           VerticalAlignment="Center"
			           Margin="0,8,8,0"/>

			<Slider x:Name="ContrastSlider"
			        Grid.Row="1"
			        Grid.Column="1"
			        MinWidth="180"
			        Margin="0,8,0,0"
			        IsEnabled="False"
			        VerticalAlignment="Center"
			        ValueChanged="ContrastSlider_ValueChanged"/>

			<TextBlock x:Name="ContrastValueText"
			           Grid.Row="1"
			           Grid.Column="2"
			           Margin="0,8,0,0"
			           Text="-"
			           VerticalAlignment="Center"
			           HorizontalAlignment="Right"/>

			<!-- Hue -->
			<TextBlock Grid.Row="1"
			           Grid.Column="4"
			           Text="Hue:"
			           VerticalAlignment="Center"
			           Margin="0,8,8,0"/>

			<Slider x:Name="HueSlider"
			        Grid.Row="1"
			        Grid.Column="5"
			        MinWidth="180"
			        Margin="0,8,0,0"
			        IsEnabled="False"
			        VerticalAlignment="Center"
			        ValueChanged="HueSlider_ValueChanged"/>

			<TextBlock x:Name="HueValueText"
			           Grid.Row="1"
			           Grid.Column="6"
			           Margin="0,8,0,0"
			           Text="-"
			           VerticalAlignment="Center"
			           HorizontalAlignment="Right"/>

		</Grid>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<!-- Controls -->
			<ui:SimpleStackPanel Grid.Column="0"
			                     Spacing="4"
			                     Margin="0,12,12,0">

				<ToggleButton x:Name="MarkButton"
				              Content="Mark"
				              Padding="12,4"
				              Checked="MarkButton_Checked"
				              Unchecked="MarkButton_Unchecked"/>

				<UniformGrid Columns="2" Rows="4">
					<TextBlock Text="X"
								Margin="0,8,0,2"
								Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
					<TextBox x:Name="RectXBox"
								Text="0"
								Width="80"/>

					<TextBlock Text="Y"
								Margin="0,4,0,2"
								Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
					<TextBox x:Name="RectYBox"
								Text="0"
								Width="80"/>

					<TextBlock Text="Width"
								Margin="0,4,0,2"
								Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
					<TextBox x:Name="RectWBox"
								Text="0"
								Width="80"/>

					<TextBlock Text="Height"
								Margin="0,4,0,2"
								Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
					<TextBox x:Name="RectHBox"
								Text="0"
								Width="80"/>
				</UniformGrid>

				<ui:SimpleStackPanel Orientation="Horizontal" Spacing="4">
					<Button x:Name="RememberButton"
							Content="Remember"
							Padding="12,4"
							Margin="0,12,0,0"
							Click="RememberButton_Click"/>
					<Button x:Name="CompareButton"
							Content="Compare"
							Padding="12,4"
							Margin="0,12,0,0"
							Click="CompareButton_Click"/>
				</ui:SimpleStackPanel>


				<Border Margin="0,8,0,0"
				        Width="80"
				        MinHeight="60"
				        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
				        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
				        BorderThickness="1"
				        CornerRadius="2">
					<Image x:Name="RememberedPreview"
					       Stretch="Uniform"/>
				</Border>

				<TextBlock x:Name="CompareResultText"
				           Margin="0,4,0,0"
				           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

			</ui:SimpleStackPanel>

			<!-- Preview -->
			<Border Grid.Column="1"
			        Margin="0,12,0,0"
			        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
			        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
			        BorderThickness="1"
			        CornerRadius="4">

				<Grid>
					<Image x:Name="PreviewImage"
					       Stretch="Uniform"/>

					<Canvas x:Name="OverlayCanvas"
					        ClipToBounds="True"
					        Background="Transparent"
					        SizeChanged="OverlayCanvas_SizeChanged"
					        MouseLeftButtonDown="Overlay_MouseDown"
					        MouseMove="Overlay_MouseMove"
					        MouseLeftButtonUp="Overlay_MouseUp">
						<Rectangle x:Name="MarkRect"
						           Stroke="{DynamicResource SystemControlForegroundAccentBrush}"
						           StrokeThickness="2"
						           Visibility="Collapsed"/>
					</Canvas>

					<TextBlock x:Name="StatusText"
					           Text="Select a camera to start preview."
					           VerticalAlignment="Center"
					           HorizontalAlignment="Center"
					           FontSize="14"
					           IsHitTestVisible="False"
					           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
				</Grid>

			</Border>
		</Grid>
	</Grid>
</base:PageBase>