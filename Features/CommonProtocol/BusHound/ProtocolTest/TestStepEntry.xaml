<UserControl x:Class="CommonProtocol.BusHound.ProtocolTest.TestStepEntry"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:ui="http://schemas.modernwpf.com/2019"
			 xmlns:local="clr-namespace:CommonProtocol.BusHound.ProtocolTest"
			 mc:Ignorable="d"
			 d:DesignHeight="56" d:DesignWidth="800">
	<UserControl.Resources>
		<SolidColorBrush x:Key="PassBg" Color="#3327C93F"/>
		<SolidColorBrush x:Key="FailBg" Color="#33FF3B30"/>
		<SolidColorBrush x:Key="SkipBg" Color="#22888888"/>
		<SolidColorBrush x:Key="PassFg" Color="#FF2FA84A"/>
		<SolidColorBrush x:Key="FailFg" Color="#FFE0342B"/>
	</UserControl.Resources>

	<Border CornerRadius="4"
			Padding="5,3,4,3"
			Margin="20,1,-5,1"
			BorderThickness="0"
			Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<!-- Type icon -->
				<ColumnDefinition Width="Auto"/>
				<!-- Badge -->
				<ColumnDefinition Width="Auto"/>
				<!-- Response time -->
				<ColumnDefinition Width="*"/>
				<!-- Preview -->
				<ColumnDefinition Width="Auto"/>
				<!-- Edit -->
				<ColumnDefinition Width="Auto"/>
				<!-- Delete -->
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- Step type icon -->
			<ui:FontIcon x:Name="TypeIcon" Grid.Column="0" Grid.Row="0"
						 Glyph="&#xE724;" FontSize="14" FontFamily="Segoe Fluent Icons"
						 VerticalAlignment="Center" Margin="4,0"
						 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

			<!-- Verdict badge -->
			<Border x:Name="Badge" Grid.Row="0" Grid.Column="1"
					Width="72" CornerRadius="4" Margin="4,0"
					VerticalAlignment="Stretch" Background="{StaticResource SkipBg}">
				<TextBlock x:Name="BadgeText" Text="--" FontWeight="SemiBold" FontSize="12"
						   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Border>

			<!-- Response Time badge -->
			<Border x:Name="ResponseTime" Grid.Row="0" Grid.Column="2"
					Width="50" CornerRadius="4" Margin="4,0"
					VerticalAlignment="Stretch" Background="{StaticResource SkipBg}">
				<TextBlock x:Name="ResponseTimeText" Text="--" FontWeight="SemiBold" FontSize="12"
						   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Border>

			<!-- Preview (step name + hex preview) -->
			<TextBlock x:Name="PreviewBlock"
					   Grid.Column="3" Grid.Row="0"
					   FontFamily="Consolas"
					   FontSize="12"
					   VerticalAlignment="Center"
					   TextTrimming="CharacterEllipsis"
					   Margin="8,0,4,0"
					   Cursor="Hand"
					   ToolTip="Click to view step details"
					   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>

			<!-- Received summary -->
			<TextBlock x:Name="ReceivedBlock"
					   Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4"
					   FontFamily="Consolas"
					   FontSize="11"
					   VerticalAlignment="Center"
					   TextTrimming="CharacterEllipsis"
					   Margin="4,1,4,0"
					   Cursor="Hand"
					   ToolTip="Click to view step details"
					   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

			<!-- Edit button -->
			<Button x:Name="EditButton"
					Grid.Column="4" Grid.Row="0"
					Padding="6 4"
					Margin="2,0"
					VerticalAlignment="Stretch"
					ToolTip="Edit step">
				<ui:FontIcon Glyph="&#xE70F;" FontSize="14" FontFamily="Segoe Fluent Icons"/>
			</Button>

			<!-- Delete button -->
			<Button x:Name="DeleteButton"
					Grid.Column="5" Grid.Row="0"
					Padding="6 4"
					Margin="2,0"
					VerticalAlignment="Stretch"
					ToolTip="Delete step">
				<ui:FontIcon Glyph="&#xE74D;" FontSize="14" FontFamily="Segoe Fluent Icons"/>
			</Button>
		</Grid>
	</Border>
</UserControl>
