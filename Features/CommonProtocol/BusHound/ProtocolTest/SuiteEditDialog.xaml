<ui:ContentDialog x:Class="CommonProtocol.BusHound.ProtocolTest.SuiteEditDialog"
				  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				  xmlns:ui="http://schemas.modernwpf.com/2019"
				  xmlns:local="clr-namespace:CommonProtocol"
				  mc:Ignorable="d"
				  Title="Edit suite"
				  PrimaryButtonText="Save"
				  CloseButtonText="Cancel"
				  DefaultButton="Primary">
	<StackPanel MinWidth="380" Margin="0,4,0,0">

		<TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
		<TextBox x:Name="NameBox" Margin="0,0,0,12"/>

		<TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,4"/>
		<TextBox x:Name="DescriptionBox"
				 AcceptsReturn="True"
				 TextWrapping="Wrap"
				 MinHeight="60"
				 MaxHeight="120"
				 Margin="0,0,0,12"/>

		<CheckBox x:Name="ResetWhenDoneCheck"
				  Content="Reset device when done (factory reset after suite)"
				  IsChecked="False"
				  Margin="0,0,0,8"/>

		<CheckBox x:Name="StopOnFirstFailureCheck"
				  Content="Stop on first failure"
				  IsChecked="True"
				  Margin="0,0,0,8"/>

		<TextBlock x:Name="ErrorText"
				   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
				   TextWrapping="Wrap"
				   Visibility="Collapsed"
				   Margin="0,8,0,0"/>
	</StackPanel>
</ui:ContentDialog>
