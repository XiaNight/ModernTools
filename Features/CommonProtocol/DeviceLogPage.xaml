<base:PageBase x:Class="CommonProtocol.DeviceLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommonProtocol"
             xmlns:base="clr-namespace:Base.Pages;assembly=Base"
             xmlns:components="clr-namespace:Base.Components;assembly=Base"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" d:Background="White">
    <Grid>
		<components:SearchableLogPanel x:Name="LogPanel">
			<components:SearchableLogPanel.AdditionalControls>
				<x:Array Type="{x:Type UIElement}">
					<Button Padding="4" Margin="0 0 8 0">
						<ui:FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="22"/>
					</Button>
					<Button Padding="4" Margin="0 0 8 0" d:Visibility="Collapsed">
						<ui:FontIcon Glyph="&#xE769;" FontFamily="Segoe Fluent Icons" FontSize="22"/>
					</Button>
				</x:Array>
			</components:SearchableLogPanel.AdditionalControls>
		</components:SearchableLogPanel>
	</Grid>
</base:PageBase>
