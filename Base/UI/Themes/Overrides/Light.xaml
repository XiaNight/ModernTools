<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:ModernWpf.Markup;assembly=ModernWpf">

	<!-- ============================================================================================
	     Light-theme keyed brush overrides for controls.

	     App.xaml merges this into the Light theme dictionary of the primary ThemeResources (the only
	     instance ModernWpf drives on a theme change). ModernWpf inserts its default Light resources
	     ahead of this list, so the aliases resolve against the Light TextControl* brushes and win by
	     order. Keep this in sync with Dark.xaml.

	     To add a control's Light-theme overrides: append its m:StaticResource lines below, grouped by
	     control (and add the matching lines to Dark.xaml). No App.xaml change is needed.
	     ============================================================================================ -->

	<!-- Button -->
	<m:StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TextControlBackgroundPointerOver"/>
	<m:StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="TextControlBorderBrushPointerOver"/>
	<m:StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TextControlBackgroundFocused"/>
	<m:StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SystemControlForegroundAccentBrush"/>

	<!-- ToggleButton (unchecked states only; checked keeps ModernWpf's accent fill). The unchecked
	     hover trigger changes Background only, so there is no PointerOver border key to override. -->
	<m:StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="TextControlBackgroundPointerOver"/>
	<m:StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="TextControlBackgroundFocused"/>
	<m:StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SystemControlForegroundAccentBrush"/>
</ResourceDictionary>
